# Copy to .env (or export these in your shell). None are needed just to run the model.

# --- Inference ---
# Hugging Face repo id or local folder the CLI loads when -m is not given.
# Default: prakriti-tts/prakriti-v1
PRAKRITI_MODEL=prakriti-tts/prakriti-v1

# --- Training pipeline (server) ---
# Where the pipeline keeps data, checkpoints, ledgers and logs.
PRAKRITI_WORK=./work
# Stage list the runner executes, in order.
PRAKRITI_PIPELINE=configs/pipeline.yaml
# Folder the export / evaluation steps read and write.
PRAKRITI_EXPORT=./work/export

# Gated datasets (Rasa, IndicVoices-R) need a Hugging Face login on the server.
# Run `hf auth login` there instead of putting a token in this file.
